{
  "name": "sub-worker",
  "version": "1.9.11",
  "private": true,
  "type": "module",
  "description": "Fixed subscription endpoint for singbox-manager, backed by Cloudflare D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "test:sqlite": "SUB_WORKER_TEST_D1=sqlite node --test",
    "db:create": "wrangler d1 create sub-worker-db",
    "db:init": "wrangler d1 execute sub-worker-db --remote --file=scripts/schema.sql",
    "db:init:local": "wrangler d1 execute sub-worker-db --local --file=scripts/schema.sql",
    "db:query": "wrangler d1 execute sub-worker-db --remote --command \"SELECT machine, bytes, manual, updated_at FROM machines ORDER BY machine\"",
    "build:single": "node scripts/build-single.mjs",
    "check": "wrangler deploy --dry-run --outdir dist",
    "test:ui": "node scripts/ui-flow.mjs",
    "bench:sub": "node scripts/bench-sub.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
